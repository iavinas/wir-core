{
  "name": "@wir/core",
  "version": "0.1.0",
  "description": "Structural interface graph runtime for browser agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "rm -rf dist-test && npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "docs": "typedoc",
    "docs:check": "typedoc --treatWarningsAsErrors",
    "check": "npm run format:check && npm run lint && npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  }
}
